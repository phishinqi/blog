---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/search/SearchDialog';
import { siteConfig, localized, authorRegistry } from '../site.config';
import { ui } from '../i18n/ui';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: { title: string; pubDate: Date; updatedDate?: Date; lang: string; authors: string[] };
  noindex?: boolean;
  profile?: { name: string; description: string };
}
const {
  title,
  description = localized(siteConfig.description),
  image = siteConfig.defaultOgImage,
  article,
  noindex = false,
  profile,
} = Astro.props;
const fullTitle = title
  ? `${title} — ${siteConfig.title}`
  : `${siteConfig.title} — ${localized(siteConfig.intro.title)}`;
const canonical = new URL(Astro.url.pathname, siteConfig.siteURL).href;
const ogImage = new URL(image, siteConfig.siteURL).href;
const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: article.title,
      description,
      datePublished: article.pubDate.toISOString(),
      dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
      author: article.authors.map((id) => ({
        '@type': 'Person',
        name: authorRegistry[id]!.name,
        url: new URL(`/authors/${id}/`, siteConfig.siteURL).href,
      })),
      mainEntityOfPage: canonical,
      image: ogImage,
      inLanguage: article.lang,
    }
  : profile
    ? {
        '@context': 'https://schema.org',
        '@type': 'ProfilePage',
        url: canonical,
        mainEntity: { '@type': 'Person', name: profile.name, description: profile.description },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteConfig.title,
        description: localized(siteConfig.description),
        url: siteConfig.siteURL,
        inLanguage: siteConfig.locale,
      };
const crumbs = title
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: ui.home, item: siteConfig.siteURL },
        ...(article
          ? [
              {
                '@type': 'ListItem',
                position: 2,
                name: ui.allPosts,
                item: new URL('/posts/', siteConfig.siteURL).href,
              },
            ]
          : []),
        { '@type': 'ListItem', position: article ? 3 : 2, name: title, item: canonical },
      ],
    }
  : null;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
    </style>
    <script is:inline>
      (() => {
        // A new navigation or a non-participating document can cancel the visual transition.
        const settleTransition = (event) => {
          event.viewTransition?.ready.catch(() => {});
          event.viewTransition?.finished.catch(() => {});
        };
        document.documentElement.classList.add('js');
        window.addEventListener('pageswap', settleTransition);
        window.addEventListener('pagereveal', settleTransition);
        let theme;
        try {
          theme = localStorage.getItem('v7-theme');
        } catch {
          /* Storage may be unavailable. */
        }
        if (theme !== 'light' && theme !== 'dark')
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        try {
          const locale = localStorage.getItem('v7-locale');
          if (locale === 'en' || locale === 'zh-CN') document.documentElement.lang = locale;
        } catch {
          /* Default language remains usable. */
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.title} RSS`}
      href={new URL('/rss.xml', siteConfig.siteURL).href}
    />
    <meta name="theme-color" content="#f8f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191817" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content={siteConfig.locale === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
    {article?.updatedDate && (
      <meta property="article:modified_time" content={article.updatedDate.toISOString()} />
    )}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    />
    {crumbs && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(crumbs).replace(/</g, '\\u003c')}
      />
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      {ui.skip}
    </a>
    <Header />
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SearchDialog client:idle labels={ui} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
