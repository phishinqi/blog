---
import type { GetStaticPaths } from 'astro';
import ListingLayout from '../../../layouts/ListingLayout.astro';
import { getPublishedPosts } from '../../../lib/content';
import { siteConfig } from '../../../site.config';
import { ui } from '../../../i18n/ui';
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const total = Math.ceil(posts.length / siteConfig.postsPerPage);
  return Array.from({ length: Math.max(0, total - 1) }, (_, index) => {
    const current = index + 2;
    return {
      params: { page: String(current) },
      props: {
        posts: posts.slice(
          (current - 1) * siteConfig.postsPerPage,
          current * siteConfig.postsPerPage,
        ),
        current,
        total,
      },
    };
  });
}) satisfies GetStaticPaths;
const { posts, current, total } = Astro.props;
---

<ListingLayout
  title={`${ui.allPosts} · ${ui.page} ${current}`}
  description={ui.postsDescription}
  posts={posts}
  current={current}
  total={total}
/>
