---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';
import { tagUrl } from '../../lib/posts';
import { siteConfig } from '../../site.config';
import { ui } from '../../i18n/ui';
const posts = await getPublishedPosts();
const tags = Array.from(new Set(posts.flatMap((post) => post.data.tags))).sort((a, b) =>
  a.localeCompare(b, siteConfig.locale),
);
---

<BaseLayout title={ui.tags}>
  <div class="reading-shell">
    <header class="page-heading">
      <h1>{ui.tags}</h1>
      <p>{ui.tagsDescription}</p>
    </header>
    <div class="tag-cloud">
      {tags.map((tag) => (
        <a href={tagUrl(tag)}>
          {tag}
          <span>{posts.filter((post) => post.data.tags.includes(tag)).length}</span>
        </a>
      ))}
    </div>
    {!tags.length && <p class="empty-state">{ui.noPosts}</p>}
  </div>
</BaseLayout>
