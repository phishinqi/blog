---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  focal?: string;
  srcset?: string;
  eager?: boolean;
  class?: string;
  sizes?: string;
}
const {
  src,
  alt,
  width,
  height,
  focal = '50% 50%',
  srcset,
  eager = false,
  class: className,
  sizes = '(max-width: 768px) calc(100vw - 3rem), 720px',
} = Astro.props;
const assets = import.meta.glob<{ default: ImageMetadata }>(
  '/public/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const local = assets[`/public${src}`]?.default;
---

{local ? (
  <Image
    src={local}
    alt={alt}
    widths={Array.from(
      new Set([160, 320, 640, 960, 1440, local.width].filter((w) => w <= local.width)),
    )}
    sizes={sizes}
    format="webp"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class={className}
    style={`object-position:${focal}`}
  />
) : (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    srcset={srcset}
    sizes={srcset ? sizes : undefined}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : 'auto'}
    class={className}
    style={`object-position:${focal}`}
  />
)}
