{
  "name": "v7-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": ">=12.5.1 <13"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "node scripts/copy-cms.mjs && astro dev",
    "dev:cms": "node scripts/dev-cms.mjs",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "node scripts/cms-config-github.mjs && node scripts/copy-cms.mjs && astro build && node scripts/build-search.mjs",
    "preview": "astro preview",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:e2e",
    "new:post": "node scripts/new-post.mjs",
    "test:variants": "node scripts/check-variants.mjs",
    "images:demo": "node scripts/generate-demo-images.mjs",
    "cms:copy": "node scripts/copy-cms.mjs",
    "cms:config": "node scripts/cms-config-github.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tabler/icons-react": "3.48.0",
    "@tailwindcss/vite": "4.3.3",
    "abcjs": "6.7.1",
    "astro": "7.3.5",
    "gsap": "3.15.0",
    "katex": "0.18.9",
    "mermaid": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
